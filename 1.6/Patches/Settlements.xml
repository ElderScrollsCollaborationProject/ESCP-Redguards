<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/FactionDef[defName="ESCP_Faction_Crowns"]</xpath>
        <value>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Sentinel</li>
                    <li>Rihad</li>
                    <li>Taneth</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>AridShrubland</li>
                    <li>Desert</li>
                </allowedBiomes>
                <clustered>true</clustered>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/FactionDef[defName="ESCP_Faction_Forebears"]</xpath>
        <value>
            <li Class="ESCP.Factions.FactionExtension_NamedSettlement">
                <settlementNames>
                    <li>Dragonstar</li>
                    <li>Elinhir</li>
                    <li>Skaven</li>
                </settlementNames>
                <preferredHilliness />
                <allowedBiomes>
                    <li>AridShrubland</li>
                    <li>Desert</li>
                </allowedBiomes>
                <clustered>true</clustered>
                <nearFaction>ESCP_Faction_Crowns</nearFaction>
            </li>
        </value>
    </Operation>

</Patch>
