        <defaultFactionDef>ESCP_Faction_Crowns</defaultFactionDef>
        <xenotypeSet>
            <xenotypeChances>
                <ESCP_Xenotype_Redguard MayRequire="Ludeon.RimWorld.Biotech">1</ESCP_Xenotype_Redguard>
            </xenotypeChances>
        </xenotypeSet>
        <useFactionXenotypes>false</useFactionXenotypes>
        <maxGenerationAge>60</maxGenerationAge>
        <chemicalAddictionChance>0</chemicalAddictionChance>
        <invNutrition>2.7</invNutrition>
        <invFoodDef>MealSurvivalPack</invFoodDef>
        <disallowedTraits><li>Nudist</li></disallowedTraits>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
        <initialResistanceRange>5~10</initialResistanceRange>
        <initialWillRange>1~3</initialWillRange>
