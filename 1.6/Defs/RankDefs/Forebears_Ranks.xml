<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ESCP.Ranks.RankTrackDef>
        <defName>ESCP_RankTrack_Forebears</defName>
        <label>the Forebears ranks</label>
        <rootTier>ESCP_Rank_Forebears_Recruit</rootTier>
        <owningFaction>ESCP_Faction_Forebears</owningFaction>
        <collectiveNoun>the Forebears</collectiveNoun>
        <drillLabel>Scimitar Drill</drillLabel>
        <drillDesc>Train with any colonist. Both stop what they are doing and both gain skill XP. Once per day.</drillDesc>
        <studyLabel>Study the Trade Laws</studyLabel>
        <studyDesc>Study with another member. Both gain skill XP. Once per day.</studyDesc>
        <inspectLabel>Check Their Kit</inspectLabel>
        <inspectDesc>Look over a junior member's gear. Good upkeep earns praise and poor upkeep earns a sharp word.</inspectDesc>
        <punishLabel>Send on Dock Patrol...</punishLabel>
        <punishDesc>Set a junior member to tedious labor for a failure, souring their mood. Once per day per member.</punishDesc>
        <rallyLabel>For Hammerfell!</rallyLabel>
        <rallyDesc>Call on {0} to fight harder for a short while. Once every few days.</rallyDesc>
        <fallInLabel>Form Up at the Gate</fallInLabel>
        <fallInDesc>Order {0} to gather behind you, up to four deep. They hold position until released.</fallInDesc>
        <dismissLabel>Back to the City</dismissLabel>
        <dismissDesc>Release {0} so they can return to their duties.</dismissDesc>
    </ESCP.Ranks.RankTrackDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Forebears_Recruit</defName>
        <label>recruit</label>
        <description>Newly sworn to the Forebears and their cities.</description>
        <nextTierOptions>
            <li>ESCP_Rank_Forebears_Warden</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Forebears_Warden</defName>
        <label>warden</label>
        <description>Keeps the peace in a Forebear city.</description>
        <minDaysInRank>4</minDaysInRank>
        <skillRequirements>
            <Melee>5</Melee>
        </skillRequirements>
        <minMissionsCompleted>1</minMissionsCompleted>
        <trainingXpPerHour>
            <Melee>400</Melee>
            <Social>200</Social>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Novice</expedition>
        <discipline>Combat</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_Forebears_Captain</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Forebears_Captain</defName>
        <label>captain</label>
        <description>Commands a city's guard.</description>
        <minDaysInRank>9</minDaysInRank>
        <skillRequirements>
            <Melee>8</Melee>
        </skillRequirements>
        <minMissionsCompleted>2</minMissionsCompleted>
        <trainingXpPerHour>
            <Melee>500</Melee>
            <Social>250</Social>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Novice</expedition>
        <discipline>Combat</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_Forebears_Magistrate</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Forebears_Magistrate</defName>
        <label>magistrate</label>
        <description>Judges disputes in a Forebear city.</description>
        <minDaysInRank>14</minDaysInRank>
        <skillRequirements>
            <Melee>11</Melee>
        </skillRequirements>
        <minMissionsCompleted>4</minMissionsCompleted>
        <trainingXpPerHour>
            <Melee>600</Melee>
            <Social>300</Social>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Veteran</expedition>
        <discipline>Combat</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_Forebears_Tribune</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_Forebears_Tribune</defName>
        <label>tribune</label>
        <description>Speaks for the Forebears in Hammerfell's councils.</description>
        <minDaysInRank>20</minDaysInRank>
        <skillRequirements>
            <Melee>14</Melee>
        </skillRequirements>
        <minMissionsCompleted>6</minMissionsCompleted>
        <trainingXpPerHour>
            <Melee>700</Melee>
            <Social>350</Social>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Faction_Veteran</expedition>
        <discipline>Combat</discipline>
    </ESCP.Ranks.RankTierDef>

</Defs>
