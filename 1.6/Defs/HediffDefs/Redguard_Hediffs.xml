<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>ESCP_Hediff_Redguard_AdrenalineRush</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>adrenaline rush</label>
        <description>Generations of Yokudan conditioning have taken over. This pawn is moving faster, hitting more accurately, and pressing through pain that would stop almost anyone else.</description>
        <defaultLabelColor>(1.0, 0.3, 0.3)</defaultLabelColor>
        <isBad>false</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>900~900</disappearsAfterTicks>
            </li>
        </comps>
        <stages>
            <li>
                <statOffsets>
                    <MoveSpeed>1.2</MoveSpeed>
                    <MeleeHitChance>0.20</MeleeHitChance>
                </statOffsets>
                <statFactors>
                    <IncomingDamageFactor>0.85</IncomingDamageFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

</Defs>
